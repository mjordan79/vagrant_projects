#cloud-config
autoinstall:
  version: 1

  keyboard:
    layout: it
  locale: it_IT.UTF-8
  updates: all

  source:
    id: ubuntu-server

  identity:
    hostname: ${hostname}
    username: vagrant
    password: "${vagrant_password_hash}"

  ssh:
    install-server: true
    allow-pw: true
    password-auth: true
    authorized-keys:
      - "${vagrant_ssh_public_key}"

  storage:
    layout:
      name: direct

  packages:
    - openssh-server
    - sudo
    - linux-virtual
    - linux-image-virtual
    - linux-cloud-tools-virtual
    - linux-tools-virtual

  user-data:
    disable_root: false

  late-commands:
    - curtin in-target -- sh -c "echo 'root:${vagrant_password_hash}' | chpasswd -e"
    - curtin in-target -- sh -c "echo 'vagrant ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/vagrant && chmod 0440 /etc/sudoers.d/vagrant"
    - curtin in-target -- sh -c "echo 'UseDNS no' >> /etc/ssh/sshd_config"
    - curtin in-target -- sh -c "echo 'GSSAPIAuthentication no' >> /etc/ssh/sshd_config"
    - curtin in-target -- sed -i 's/X11Forwarding yes/X11Forwarding no/' /etc/ssh/sshd_config"

    - curtin in-target -- apt-get update
    - curtin in-target -- apt-get -y full-upgrade
    - curtin in-target -- apt-get -y autoremove --purge
    - curtin in-target -- apt-get -y autoclean
    - curtin in-target -- apt-get -y clean

    - curtin in-target -- rm -rf /var/cache/apt/archives/*.deb
    - curtin in-target -- find /var/log -type f -exec truncate -s 0 {} \;
    - curtin in-target -- rm -rf /tmp/*
    - curtin in-target -- rm -rf /root/.cache/*
    - curtin in-target -- find /boot -name "*.old" -delete

    - curtin in-target -- truncate -s 0 /etc/machine-id
    - curtin in-target -- rm -f /var/lib/dbus/machine-id
